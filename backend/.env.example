# Configurações do Banco de Dados (Supabase / Postgres)
DATABASE_URL=postgresql://postgres:sua_senha@seu_host:5432/postgres

# Chaves de API de Provedores (Preencha as que for usar)
OPENAI_API_KEY=sk-proj-xxxx
GEMINI_API_KEY=AIzaSy-xxxx

# Configurações do Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Configurações do Motor LightRAG
LIGHTRAG_API_URL=http://localhost:9621

# Configurações de Embedding e Busca (Opcional - Ver defaults em app/core/config.py)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DOCS_DIR=./docs/sil
