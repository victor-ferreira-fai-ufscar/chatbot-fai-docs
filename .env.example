OPENAI_API_KEY=<SUA_CHAVE_AQUI>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Banco de historico de conversas (Supabase self-hosted / Postgres)
# Host = IP/host da maquina do Supabase; porta = 5432 (direto) ou 6543 (pooler Supavisor)
#DATABASE_URL=postgresql://postgres:<SENHA>@<IP_OU_HOST>:5432/postgres
# Numero de turnos do historico enviados ao LightRAG como contexto
HISTORY_TURNS=5
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_THRESHOLD=0.0
LIGHTRAG_API_URL=http://localhost:9621

# Supabase Storage — repositorio de documentos e entrega via URL assinada
# (necessario para a entrega de documentos com resolucao por IA)
#SUPABASE_URL=https://<seu-host-supabase>
#SERVICE_ROLE_KEY=<sua_service_role_key>
SUPABASE_BUCKET=manuais
SIGNED_URL_TTL=3600