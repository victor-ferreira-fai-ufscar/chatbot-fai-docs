.venv/
__pycache__/
*.pyc

# Testes e Arquivos soltos
.pytest_cache/
.teste_connex_supabase.py
debug_pdf.py

# Caches de Estado do Projeto e Arquivos de Ambiente
.env
.sync_state.json
docs/sil/.sync_state.json

# Dados locais do LightRAG (grafo, vetores e copias dos PDFs de entrada)
lightrag/data/
.streamlit/
.vscode/

# Reranker: cache de modelos do HuggingFace baixado em runtime (GBs). Recriado
# automaticamente pelo bind-mount do docker-compose. (cache/ = legado Infinity/CPU;
# tei-cache/ = TEI na GPU, em uso.)
reranker/cache/
reranker/tei-cache/

# Caddy: CA interna, certificados e estado (gerados em runtime)
caddy/data/
caddy/config/

# Ignore de Sistema Operacional
.DS_Store
Thumbs.db
# Artefatos de eval das baterias (snapshots de run, não código): JSONs de apoio
# gravados por backend/eval/*.py e os arquivamentos de runs antigos. São grandes,
# mudam a cada execução e poluíam ~34 linhas do `git status`.
backend/eval/.bateria_consolidado*.json
backend/eval/.last_run*.json
# .probe_*.json NAO entram aqui: .probe_high/medium/tuned.json sao RASTREADOS no git
# (gitignore nao afeta arquivo ja rastreado, mas listar confunde quem le)
backend/eval/.recall_*.json
backend/eval/.flips_*.json
backend/eval/_arquivo/
docs/Perguntas e respostas Recentes/_arquivo/
